# Cấu hình harness của Lyris. verification/verify.sh và environment/ đọc file này (source bằng bash).
# Đổi cấu hình ở đây, KHÔNG sửa script.
#
#   STACK=fullstack → backend FastAPI (pytest) trong BACKEND_DIR + frontend React/Vite (node --test, tsc, vite build)
#                     trong FRONTEND_DIR, bot Chrome chạy trên server LLM giả.

STACK=fullstack
BACKEND_DIR=backend
FRONTEND_DIR=frontend

# Cổng riêng cho bot và server test. KHÔNG dùng 8000/5173 (có thể là app của chủ dự án đang chạy).
BOT_BACKEND_PORT=8066
BOT_FRONTEND_PORT=8067
